# =============================================================================
# Clever AI Gate — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# WARNING: Never commit .env to version control!
#
# IMPORTANT: Do NOT use inline comments on value lines.
# Some platforms (Clever Cloud) include the full line as the value.
# =============================================================================

# --- Server ---
PORT=8080

# Gin mode: "debug" for development, "release" for production
GIN_MODE=release

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgres://gateway:localdevpassword@localhost:5432/clever_ai_gate?sslmode=disable

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Security ---
# AES-256-GCM master key for encrypting provider API keys (64 hex chars = 32 bytes)
# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Admin API key for management endpoints (minimum 16 characters)
# Generate with: openssl rand -hex 24
ADMIN_API_KEY=admin_local_dev_key_1234567890

# --- Cache ---
CACHE_MAX_SIZE_MB=256
CACHE_NUM_COUNTERS=1000000

# --- Telemetry ---
TELEMETRY_FLUSH_INTERVAL=2s
TELEMETRY_BATCH_SIZE=500
TELEMETRY_QUEUE_SIZE=10000

# --- Transport (Advanced) ---
MAX_IDLE_CONNS=5000
MAX_IDLE_CONNS_PER_HOST=500
IDLE_CONN_TIMEOUT=120s
DIAL_TIMEOUT=2s
KEEP_ALIVE=90s

# Edge probing: comma-separated list of upstream hosts to probe for fastest
# Anycast CDN edge IP. Leave empty to disable. The prober also pre-warms
# HTTP/2 idle connections to these hosts every 15 seconds.
EDGE_PROBE_HOSTS=api.cloudflare.com,api-inference.huggingface.co

# --- Rate Limiting ---
DEFAULT_RATE_LIMIT_RPM=60

# --- Logging ---
# Options: "debug", "info", "warn", "error"
LOG_LEVEL=info

# --- Stream resilience ---
# SSE comment heartbeat interval while the upstream is silently thinking.
# Keeps intermediaries from killing "idle" long generations. Go duration format.
STREAM_HEARTBEAT_INTERVAL=15s
# Force-close upstream bodies silent for this long — converts hangs the rescue
# machinery can act on instead of hanging the client forever.
STREAM_IDLE_TIMEOUT=5m
# Seamless mid-stream rescue attempts per request when an upstream dies
# mid-generation (partial output is spliced into a continuation request).
MAX_STREAM_CONTINUATIONS=2
